# Credentials (copy this file to .env and fill in — .env is gitignored)

# OpenCode zen key — one name for every zen agent: moca, OpenCode and Pi (the
# `opencode-go` tier). It is also moca's own built-in default for that
# provider, so nothing needs a second variable.
OPENCODE_API_KEY=

# Claude Code — either an Anthropic API key …
ANTHROPIC_API_KEY=
# … or a subscription OAuth token from `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=

# Run knobs (defaults shown; all optional)

# ZEN_MODEL=opencode-go/deepseek-v4.1-flash
# CLAUDE_MODEL=anthropic/claude-sonnet-5
# MOCA_VERSION=v0.7.10
# MOCA_MAX_STEPS=100
# MOCA_MODE=yolo
# OPENCODE_VERSION=2.1.4
# PI_VERSION=1.4.0
# CLAUDE_VERSION=2.1.310
# N_TASKS=20
# N_CONCURRENT=2
# N_ATTEMPTS=1
# JOBS_DIR=results/jobs
# AGENTS=moca,opencode,pi,claude-code
# TASK_NAMES=task-a,task-b
# HARBOR_VERSION=0.24.0
